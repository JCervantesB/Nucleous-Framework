# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://user:password@host/database?sslmode=require'

# Activar modulos
ENABLED_MODULES=AI,EMAIL,STORAGE,PRODUCTS,INVENTORY_STOCK_FORECAST

# Proveedor de almacenamiento para documentos de usuario (uploadthing, cloudinary, etc.), si no se define el default es local
STORAGE_PROVIDER=uploadthing

# --- Servicios ---

# Auth (better-auth)
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Social Providers (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- IA: AI Module (Vercel AI SDK) ---
# API Keys - Proveedores soportados: openrouter, openai, anthropic, groq, mistral, perplexity
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
AI_GATEWAY_API_KEY=

# Configuración por defecto
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=google/gemma-4-31b-it:free
AI_DEFAULT_MODEL_ALIAS=reasoning

# --- Stock Forecast ---
AI_STOCK_FORECAST_ENABLED=false
AI_STOCK_FORECAST_MODEL=openai/gpt-4o-mini
STOCK_FORECAST_DEFAULT_DAYS=30
STOCK_FORECAST_HISTORY_DAYS=90
STOCK_FORECAST_CONFIDENCE_THRESHOLD=0.7

# --- Email ---
EMAIL_SERVICE=smtp
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_AUTH_USER=
EMAIL_AUTH_PASSWORD=

# --- Archivos: UploadThing (Documentos de usuario) ---
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# --- Imágenes: Cloudinary (Evidencia de entrega) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
